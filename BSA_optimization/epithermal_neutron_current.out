[ T-Cross ]
    title = Epithermal neutron current
     mesh =  reg            $ mesh type is region-wise
      reg =    1            $ number of crossing regions
      non     r-from    r-to       area
      1       903       201        78.53982    
   e-type =    1            $ e-mesh is given by the below data
       ne =      1          $ number of e-mesh points
$    data = ( e(i), i = 1, ne + 1 )
            5.00000E-07  1.00000E-02
  eng2let =    0            $ (D=0) Flag to convert energy to LET, 0: not convert, 1: convert
     unit =    1            $ unit is [1/cm^2/source]
     axis =  reg            $ axis of output
     file = epithermal_neutron_current.out  $ file name of output for the above axis
   output = current         $ surface crossing current spectrum
     part =  neutron  
$ kf/name :  2112     
   stdcut = 5.0000000E-02   $ (D=-1) threshold value of STD cutoff
$    used :        main (  %)        temp (  %)       total (  %)
$  memory :          10 (  0)           0 (  0)          10 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1
#   e = (   5.0000E-07  -   1.0000E-02  )

x: Serial Num. of Region
y: Current [1/cm^2/source]                 
p: xlin ylog afac(0.8) form(0.9)
h: x       n            y(neutron ),l3 n   
#  num            area       neutron  r.err 
     1      7.8540E+01   7.9696E+08  0.0027

# sum over  7.8540E+01   7.9696E+08  0.0027

'no. =  1,  e =  1.0000E-02'
msuc: {\huge Epithermal neutron current}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.37}
wt: s(0.7)
\vspace{-3}
  region surface crossing
  emin  &=&   5.0000E-07 [MeV/n]
  emax  &=&   1.0000E-02 [MeV/n]
e:
 
# Information for Restart Calculation
# This calculation was newly started
# istdev =  2 # 1:Batch variance, 2:History variance
# resc2  = 1.60230732254525997E-08 # Total source weight or Total source weight / maxcas
# resc3  = 1.00000000000000000E+08 # Total history number or Total batch number
# maxcas =      100000 # History / Batch, only used for istdev=1
# bitrseed = 1101111110010001010110101011011001110100110101001100011110000101 # bit data of rseed
