[ T-Track ]
    title = Neutron flux
     mesh =  r-z            $ mesh type is r-z scoring mesh
       x0 =   0.000000      $ center x-position of r-z mesh
       y0 =   0.000000      $ center y-position of r-z mesh
   r-type =    1            $ r-mesh is given by the below data
       nr =      1          $ number of r-mesh points
$    data = ( r(i), i = 1, nr + 1 )
            0.00000E+00  5.00000E+00
   z-type =    2            $ z-mesh is linear given by zmin, zmax and nz
     zmin =   70.20000      $ minimum value of z-mesh points
     zmax =   70.30000      $ maximum value of z-mesh points
$    zdel =  0.1000000      $ mesh width of z-mesh points
       nz =      1          $ number of z-mesh points
$    data = ( z(i), i = 1, nz + 1 )
$           7.02000E+01  7.03000E+01
   e-type =    1            $ e-mesh is given by the below data
       ne =      3          $ number of e-mesh points
$    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  5.00000E-07  1.00000E-02  2.00000E+01
     unit =    1            $ unit is [1/cm^2/source]
 material =  all            $ (D=all) number of specific material
     axis =       z            $ axis of output
     file = neutron_flux.out  $ file name of output for the above axis
     part =  neutron  
$ kf/name :  2112     
   stdcut = 5.0000000E-02   $ (D=-1) threshold value of STD cutoff
$    used :        main (  %)        temp (  %)       total (  %)
$  memory :          12 (  0)           0 (  0)          12 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   ir  =  1
#   e = (   0.0000E+00  -   5.0000E-07  )
#   r = (   0.0000E+00  -   5.0000E+00  )

x: z [cm]
y: Flux [1/cm^2/source]              
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(neutron ),hh0l n  
#  z-lower      z-upper        neutron   r.err 
   7.0200E+01   7.0300E+01   2.1038E+06  0.0624

#   sum over    7.8540E+00   2.1038E+06  0.0624

'no. =  1,  ie =  1,  ir =  1'
msuc: {\huge Neutron flux}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.37}
wt: s(0.7)
\vspace{-3}
  emin  &=&   0.0000E+00 [MeV/n]
  emax  &=&   5.0000E-07 [MeV/n]
  rmin  &=&   0.0000E+00 [cm]
  rmax  &=&   5.0000E+00 [cm]
e:

#------------------------------------------------------------------------------
 newpage:
#   no. =  2   ie  =  2   ir  =  1
#   e = (   5.0000E-07  -   1.0000E-02  )
#   r = (   0.0000E+00  -   5.0000E+00  )

x: z [cm]
y: Flux [1/cm^2/source]              
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(neutron ),hh0l n  
#  z-lower      z-upper        neutron   r.err 
   7.0200E+01   7.0300E+01   1.7806E+09  0.0028

#   sum over    7.8540E+00   1.7806E+09  0.0028

'no. =  2,  ie =  2,  ir =  1'
msuc: {\huge Neutron flux}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.37}
wt: s(0.7)
\vspace{-3}
  emin  &=&   5.0000E-07 [MeV/n]
  emax  &=&   1.0000E-02 [MeV/n]
  rmin  &=&   0.0000E+00 [cm]
  rmax  &=&   5.0000E+00 [cm]
e:

#------------------------------------------------------------------------------
 newpage:
#   no. =  3   ie  =  3   ir  =  1
#   e = (   1.0000E-02  -   2.0000E+01  )
#   r = (   0.0000E+00  -   5.0000E+00  )

x: z [cm]
y: Flux [1/cm^2/source]              
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(neutron ),hh0l n  
#  z-lower      z-upper        neutron   r.err 
   7.0200E+01   7.0300E+01   2.1045E+09  0.0026

#   sum over    7.8540E+00   2.1045E+09  0.0026

'no. =  3,  ie =  3,  ir =  1'
msuc: {\huge Neutron flux}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.37}
wt: s(0.7)
\vspace{-3}
  emin  &=&   1.0000E-02 [MeV/n]
  emax  &=&   2.0000E+01 [MeV/n]
  rmin  &=&   0.0000E+00 [cm]
  rmax  &=&   5.0000E+00 [cm]
e:
 
